# Copy to .env and fill in. .env is gitignored — never commit it.

# Get a free key at https://console.groq.com  -> API Keys
GROQ_API_KEY=gsk_your_key_here

# Planning and synthesis. Verify availability: GET /openai/v1/models
MODEL_NAME=openai/gpt-oss-120b

# The per-branch sufficiency self-check (agents/search_agent.py).
#
# Uses a separate model because Groq's free tier meters 8000 tokens/minute per
# model, and a three-branch turn needs about 14k tokens. Moving the self-check to
# a second model's bucket cut a three-branch turn from ~41 s to ~7 s with the same
# output. On six evidence packs, 20b matched 120b on parse rate and was faster.
FAST_MODEL_NAME=openai/gpt-oss-20b

# Set to 0 to run the self-check on MODEL_NAME instead (one bucket, slower).
ALLOW_FAST_MODEL=1

# runner = hand-written async orchestrator. graph = LangGraph.
ORCHESTRATOR=runner

# ---- Optional. The defaults below are what the code uses when these are unset. ----

# 0 disables LLM cache READS (data/.llm_cache, gitignored). Writes stay on, so a cold
# pass refills the cache and the next run replays it. The eval harness sets this itself.
LLM_CACHE=1

# 1 collapses each evidence pack to one chunk per (doc, page). Off by default: the
# chunk it drops is the prose copy that carries qualifiers the table omits.
DIVERSIFY_BY_PAGE=0

# Where the embedding model downloads to. Unset -> ./.hf_cache inside the repo
# (core/paths.py). A value already in the environment always wins.
# HF_HOME=
